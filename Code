# Pet Shop Management System

records = []

while True:
    print("\n===== PET SHOP MANAGEMENT =====")
    print("1. Add New Customer")
    print("2. Search Customer")
    print("3. Show All Records")
    print("4. Exit")

    choice = input("Enter your choice: ")

    if choice == "1":
        customer = {
            "Customer Name": input("Enter Customer Name: "),
            "Animal Name": input("Enter Animal Name: "),
            "Breed": input("Enter Animal Breed: "),
            "Price": input("Enter Price: "),
            "Date Sold": input("Enter Date Sold: "),
            "Time Sold": input("Enter Time Sold: ")
        }

        records.append(customer)
        print("Record Added Successfully!")

    elif choice == "2":
        name = input("Enter Customer Name to Search: ")

        found = False
        for customer in records:
            if customer["Customer Name"].lower() == name.lower():
                print("\nCustomer Details")
                for key, value in customer.items():
                    print(key, ":", value)
                found = True

        if not found:
            print("Customer Not Found!")

    elif choice == "3":
        if len(records) == 0:
            print("No Records Available!")
        else:
            print("\nAll Customer Records:")
            for customer in records:
                print("-" * 30)
                for key, value in customer.items():
                    print(key, ":", value)

    elif choice == "4":
        print("Thank You!")
        break

    else:
        print("Invalid Choice!")
